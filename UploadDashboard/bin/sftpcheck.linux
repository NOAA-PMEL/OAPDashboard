#!/bin/bash

DS_ID=$1

# problems connecting to sftp from new mac due to newer version of OpenSSH.  Fixed with the added options.
if [ $DS_ID ] ; then
	sftp -o IdentityFile=/home/hazy/kamb/.ssh/ncei-key-rsa ncei_sftp@sftp.pmel.noaa.gov << end_sftp_check
cd data/oap
ls -l $1
end_sftp_check
else
	sftp -o IdentityFile=/home/hazy/kamb/.ssh/ncei-key-rsa ncei_sftp@sftp.pmel.noaa.gov
fi

